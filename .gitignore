# Build outputs
/bin/
/dist/
*.exe
*.exe~

# Wails v3 build output (binaries land here)
bin/
build/bin/

# Task runner cache
.task/

# Preserve NSS certutil binaries for Windows fresh Firefox installs
!assets/nss/win32/*.exe

# Frontend build output and node_modules
frontend/dist/*
!frontend/dist/.gitkeep
frontend/node_modules/
frontend/bindings/

# Test and temp files
*.test
*.tmp
*.log

# Runtime logs
logs/

# Secrets and runtime config
.env
.env.local
*firebase-service-account*.json
*service-account*.json
credentials.json
internal/config/env_defaults.go
